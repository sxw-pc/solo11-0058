{
  "queries": [
    {
      "query_id": "q_readings_hot_day",
      "table": "readings",
      "select": [
        "station_id",
        "observed_at",
        "value"
      ],
      "expected_columns": [
        "station_id",
        "observed_at",
        "value"
      ],
      "where": "dt >= '2024-01-02' AND value > 40.0",
      "description": "Find hot readings from the latest two days."
    },
    {
      "query_id": "q_readings_null_humidity",
      "table": "readings",
      "select": [
        "station_id",
        "humidity"
      ],
      "expected_columns": [
        "station_id",
        "humidity"
      ],
      "where": "dt = '2024-01-02' AND humidity IS NULL",
      "description": "Find second-day readings with missing humidity."
    },
    {
      "query_id": "q_events_battery",
      "table": "events",
      "select": [
        "event_id",
        "status",
        "battery_pct"
      ],
      "expected_columns": [
        "event_id",
        "status",
        "battery_pct"
      ],
      "where": "status IN ('ok', 'retry') AND battery_pct >= 20",
      "description": "Find healthy or retrying events with enough battery."
    },
    {
      "query_id": "q_stations_active",
      "table": "stations",
      "select": [
        "station_id",
        "active"
      ],
      "expected_columns": [
        "station_id",
        "active"
      ],
      "where": "active = true",
      "description": "List active monitoring stations."
    },
    {
      "query_id": "q_readings_window",
      "table": "readings",
      "select": [
        "station_id",
        "observed_at",
        "value"
      ],
      "expected_columns": [
        "station_id",
        "observed_at",
        "value"
      ],
      "where": "dt BETWEEN '2024-01-02' AND '2024-01-03' AND value >= 12.5",
      "description": "Inspect a two-day measurement window."
    },
    {
      "query_id": "q_readings_upper_region",
      "table": "readings",
      "select": [
        "station_id",
        "region"
      ],
      "expected_columns": [
        "station_id",
        "region"
      ],
      "where": "region = 'R1'",
      "description": "Demonstrate case-sensitive partition comparison."
    },
    {
      "query_id": "q_stations_notes",
      "table": "stations",
      "select": [
        "station_id",
        "notes"
      ],
      "expected_columns": [
        "station_id",
        "notes"
      ],
      "where": "notes IS NOT NULL",
      "description": "List stations with operational notes."
    }
  ],
